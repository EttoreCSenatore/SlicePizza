# The "web" container: the one door into SlicePizza.
#
#   https://slicepizza.senatore.tech/          -> the menu site (static files)
#   https://slicepizza.senatore.tech/api/...   -> the Orders API (/api is removed)
#
# Site and API share one origin, so the browser needs no CORS (see ADR 0003).
#
# HTTPS: in production the server's own proxy (Dokploy) holds the certificate
# for the domain and forwards plain HTTP to this container. Caddy therefore
# only listens on :8080 and does not try to get certificates itself.
#
# Settings from the environment:
#   API_UPSTREAM       where the API listens, as host:port   (default api:8000)
#   SITE_ROOT          folder with the site's files          (default /srv)
#   EXTRA_CONNECT_SRC  other origins the page may call, space-separated
#   TELEGRAM_BOT_USERNAME  the bot for "Follow on Telegram" (see config.js below)
#                      (default none: the page only calls its own /api).
#                      Needed only if config.js points at an API elsewhere.
{
	# No admin endpoint, no certificates, nothing written to disk:
	# the container can run as an unprivileged user.
	admin off
	auto_https off
	persist_config off

	servers {
		# Requests arrive through the server's proxy (Traefik, in Dokploy) or
		# Docker's port forwarding, both from private addresses. Trusting them
		# keeps the X-Forwarded-For and X-Forwarded-Proto they send, so the
		# access log and the API see the customer's IP and "https", not the
		# proxy's IP and "http". Nothing outside the server reaches :8080.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	encode zstd gzip

	# One access log line per request, on stdout (Phase 5 collects it).
	log

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# The API's /internal routes are for the notification worker only, on the
	# project network (ADR 0006): never reachable from the internet. The API
	# also requires a token there; this keeps them out of reach either way.
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond "Not Found" 404
	}

	# /api/menu reaches the API as /menu. The API is started with
	# UVICORN_ROOT_PATH=/api, so the links it generates (the interactive docs
	# at /api/docs) include the prefix.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle {
		root * {$SITE_ROOT:/srv}

		# config.js is a template: Caddy fills in settings from the container's
		# environment when it serves it, so one image works everywhere. Only
		# that file: the others are served as they are.
		#   TELEGRAM_BOT_USERNAME  the bot behind "Follow on Telegram" (ADR 0006);
		#                          empty: no button
		@config path /config.js
		templates @config {
			mime application/javascript text/javascript
		}
		file_server

		header {
			# Every deploy can change index.html, app.js and config.js. The
			# browser keeps them but asks first (cheap: 304 Not Modified).
			Cache-Control "no-cache"
			# Only this site's own files, plus the fonts from Google Fonts.
			# The swagger page at /api/docs is not covered (different handle).
			Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' {$EXTRA_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}
	}
}
