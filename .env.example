# Copy this file to .env and change the password.
# The real .env is ignored by Git.
#
# If the password contains characters such as @ : / ? # %, URL-encode them
# (for example, @ becomes %40) because it is embedded in DATABASE_URL.

POSTGRES_USER=slicepizza
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=slicepizza
