# Copy this file to .env and change the password.
# The real .env is ignored by Git.
#
# The password can contain any character (@ : / ? % ...) without encoding:
# the API receives it as a separate variable, not inside a URL.
# If it contains #, $ or spaces, wrap it in single quotes: POSTGRES_PASSWORD='p@ss #1'

POSTGRES_USER=slicepizza
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=slicepizza
